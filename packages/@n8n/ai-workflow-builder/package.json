{
  "name": "@n8n/ai-workflow-builder",
  "version": "1.0.0",
  "description": "Fair-code AI workflow builder: SDK-code tool descriptors, parse/validate, session storage, and the builder agent surface.",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p ./tsconfig.build.json",
    "build:unchecked": "tsc -p ./tsconfig.build.json --noCheck",
    "format": "biome format --write src",
    "format:check": "biome ci src",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "watch": "tsc -p ./tsconfig.build.json --watch",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:dev": "vitest --silent=false"
  },
  "dependencies": {
    "@langchain/core": "catalog:",
    "@n8n/api-types": "workspace:*",
    "@n8n/backend-common": "workspace:*",
    "@n8n/utils": "workspace:*",
    "@n8n/workflow-sdk": "workspace:*",
    "@n8n_io/ai-assistant-sdk": "catalog:",
    "n8n-workflow": "workspace:*"
  },
  "devDependencies": {
    "@n8n/typescript-config": "workspace:*",
    "@n8n/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:typescript",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-mock-extended": "catalog:"
  },
  "license": "LicenseRef-n8n-sustainable-use"
}
